{
    "compilerOptions": {
        "allowJs": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "isolatedModules": true,
        "target": "ESNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@/*": ["./resources/js/*"],
            "@/boardui/*": ["./resources/js/Components/boardui/*"],
            "next/link": ["./resources/js/Components/boardui/shims/next-link.tsx"],
            "next/image": ["./resources/js/Components/boardui/shims/next-image.tsx"],
            "next/navigation": ["./resources/js/Components/boardui/shims/next-navigation.ts"],
            "ziggy-js": ["./vendor/tightenco/ziggy"]
        }
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "resources/js/**/*.d.ts"]
}
